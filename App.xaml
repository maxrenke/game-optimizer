<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="GameOptimizer.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GameOptimizer"
    xmlns:conv="using:GameOptimizer.Converters"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <conv:PctToColorConverter x:Key="PctToColorConverter" />
            <conv:PctToTextConverter x:Key="PctToTextConverter" />
            <conv:BoolToStatusColorConverter x:Key="BoolToStatusColorConverter" />
            <conv:BoolToStatusTextConverter x:Key="BoolToStatusTextConverter" />
            <conv:BoolToGlyphConverter x:Key="BoolToGlyphConverter" />
            <conv:BoolToGamingBrushConverter x:Key="BoolToGamingBrushConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:InvertBoolToVisibilityConverter x:Key="InvertBoolToVisibilityConverter" />
            <conv:TempToColorConverter x:Key="TempToColorConverter" />
            <conv:AlertToGlyphConverter x:Key="AlertToGlyphConverter" />
            <conv:AlertToColorConverter x:Key="AlertToColorConverter" />
            <conv:PinToTextConverter x:Key="PinToTextConverter" />
            <conv:PinToColorConverter x:Key="PinToColorConverter" />
            <conv:PinToBgConverter x:Key="PinToBgConverter" />
            <conv:PinToBorderConverter x:Key="PinToBorderConverter" />
            <conv:PinToOnOffConverter x:Key="PinToOnOffConverter" />
            <conv:ReportCountConverter x:Key="ReportCountConverter" />
            <conv:DoubleToF0Converter x:Key="DoubleToF0Converter" />
            <conv:RateValueConverter x:Key="RateValueConverter" />
            <conv:RateUnitConverter x:Key="RateUnitConverter" />
            <conv:RateConverter x:Key="RateConverter" />

            <!-- ── Shared surface palette ─────────────────────────────── -->
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#11141C" Opacity="0.92" />
            <SolidColorBrush x:Key="CardBorderBrush"     Color="#22FFFFFF" />
            <SolidColorBrush x:Key="HairlineBrush"       Color="#14FFFFFF" />

            <x:Double x:Key="CardRadius">8</x:Double>

            <!-- Unified card container -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,10" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            </Style>

            <!-- Small all-caps section label (CPU ZONES, GPU, NETWORK, ...) -->
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Opacity" Value="0.55" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="120" />
            </Style>

            <!-- Tiny stat caption above a big number (DOWNLOAD, PING, ...) -->
            <Style x:Key="StatCaptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="9" />
                <Setter Property="Opacity" Value="0.45" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="80" />
            </Style>

            <!-- Monospaced metric value -->
            <Style x:Key="MonoValueStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Inline metric caption (Util, VRAM, Temp, ...) -->
            <Style x:Key="MetricCaptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Opacity" Value="0.7" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Explanatory help text under a setting -->
            <Style x:Key="HelpTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Opacity" Value="0.6" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
