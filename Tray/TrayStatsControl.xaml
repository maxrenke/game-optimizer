<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="GameOptimizer.Tray.TrayStatsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border CornerRadius="10" Padding="14,12" Width="230"
            BorderThickness="1">
        <Border.Background>
            <SolidColorBrush Color="#E0141622" />
        </Border.Background>
        <Border.BorderBrush>
            <SolidColorBrush Color="#40FFFFFF" />
        </Border.BorderBrush>
        <StackPanel Spacing="7">

            <!-- Status row -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon x:Name="StatusIcon" Glyph="&#xE7FC;" FontSize="13"
                          Foreground="#80808080" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" FontSize="12" FontWeight="SemiBold"
                           Foreground="#80FFFFFF" VerticalAlignment="Center" Text="IDLE" />
            </StackPanel>

            <Rectangle Height="1" Opacity="0.15">
                <Rectangle.Fill><SolidColorBrush Color="White" /></Rectangle.Fill>
            </Rectangle>

            <!-- CPU -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="38"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="CPU Game" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" x:Name="CpuBar" Maximum="100" Height="6"
                             CornerRadius="3" Foreground="#60E060" />
                <TextBlock Grid.Column="2" x:Name="CpuText" FontFamily="Consolas" FontSize="11"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#60E060" Text="0%" />
            </Grid>

            <!-- GPU -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="38"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="GPU Util" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                <ProgressBar Grid.Column="1" x:Name="GpuBar" Maximum="100" Height="6"
                             CornerRadius="3" Foreground="#40C0FF" />
                <TextBlock Grid.Column="2" x:Name="GpuText" FontFamily="Consolas" FontSize="11"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#40C0FF" Text="0%" />
            </Grid>

            <!-- GPU Temp -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="GPU Temp" FontSize="11" Opacity="0.6" Width="70" VerticalAlignment="Center" />
                <TextBlock x:Name="TempText" FontFamily="Consolas" FontSize="11"
                           Foreground="#FFCC80" VerticalAlignment="Center" Text="-" />
            </StackPanel>

            <!-- Network -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Net RX" FontSize="11" Opacity="0.6" Width="70" VerticalAlignment="Center" />
                <TextBlock x:Name="NetText" FontFamily="Consolas" FontSize="11"
                           Foreground="#40E0E0" VerticalAlignment="Center" Text="0 KB/s" />
            </StackPanel>

            <Rectangle Height="1" Opacity="0.15">
                <Rectangle.Fill><SolidColorBrush Color="White" /></Rectangle.Fill>
            </Rectangle>

            <!-- Pin state -->
            <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon x:Name="PinIcon" Glyph="&#xE718;" FontSize="12"
                          Foreground="#808080" VerticalAlignment="Center" />
                <TextBlock x:Name="PinText" FontSize="11" Opacity="0.7"
                           VerticalAlignment="Center" Text="Pinning OFF" />
            </StackPanel>

        </StackPanel>
    </Border>
</UserControl>
