<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="GameOptimizer.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="using:GameOptimizer.Services"
    mc:Ignorable="d"
    Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" Padding="24,16,24,24" MaxWidth="700">

            <!-- Header -->
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackBtn" Click="BackBtn_Click" Style="{StaticResource AccentButtonStyle}"
                        Padding="10,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                        <TextBlock Text="Back" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"/>
                    <TextBlock Text="Tuning profile, thresholds, and game detection"
                               Style="{StaticResource HelpTextStyle}" />
                </StackPanel>
            </Grid>

            <!-- Behavior -->
            <Expander Header="Behavior" IsExpanded="True"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8" Padding="0,8,0,0">
                    <ToggleSwitch Header="Start minimized to tray"
                                  IsOn="{x:Bind ViewModel.StartMinimized, Mode=TwoWay}" />
                    <ToggleSwitch Header="Start with Windows"
                                  IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" />
                    <ToggleSwitch Header="Flush standby RAM when a game launches"
                                  IsOn="{x:Bind ViewModel.AutoFlushStandby, Mode=TwoWay}" />
                    <TextBlock Text="Purges the Windows standby memory list so a game starts with more free RAM."
                               Style="{StaticResource HelpTextStyle}" />
                    <ToggleSwitch Header="Disable Game DVR / background capture while pinning"
                                  IsOn="{x:Bind ViewModel.DisableGameDvr, Mode=TwoWay}" />
                    <TextBlock Text="Disables Xbox background recording (GameDVR_Enabled, AppCaptureEnabled) while CPU pinning is active. Restored when pinning is turned off."
                               Style="{StaticResource HelpTextStyle}" />
                    <ToggleSwitch Header="Auto-enable CPU pinning when a game is detected"
                                  IsOn="{x:Bind ViewModel.AutoPinOnGameDetect, Mode=TwoWay}" />
                    <TextBlock Text="Turns pinning on when a game launches and back off when it exits. Manual toggles always win - turning pinning off by hand keeps it off."
                               Style="{StaticResource HelpTextStyle}" />
                    <ToggleSwitch Header="Lock GPU clocks to max while a game runs"
                                  IsOn="{x:Bind ViewModel.LockGpuClocks, Mode=TwoWay}" />
                    <TextBlock Text="Pins NVIDIA graphics clocks via nvidia-smi to prevent P-state oscillation (microstutter). Reset when the game exits. No effect without an NVIDIA GPU."
                               Style="{StaticResource HelpTextStyle}" />
                    <TextBox Header="Services to stop during a session (comma-separated)"
                             Text="{x:Bind ViewModel.StopServicesText, Mode=TwoWay}"
                             PlaceholderText="WSearch, DiagTrack" />
                    <TextBlock Text="Stopped when the optimizer starts and restarted on exit. Startup type is never changed. Applies at the next optimizer start."
                               Style="{StaticResource HelpTextStyle}" />
                </StackPanel>
            </Expander>

            <!-- Network -->
            <Expander Header="Network Adapter" IsExpanded="True"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8" Padding="0,8,0,0">
                    <TextBox Header="NIC Name" Text="{x:Bind ViewModel.NicName, Mode=TwoWay}"
                             PlaceholderText="e.g. Ethernet 2" />
                    <TextBlock Text="Name from Get-NetAdapter. Leave blank to auto-detect."
                               Style="{StaticResource HelpTextStyle}" />
                    <TextBox Header="Ping host (latency/jitter)" Text="{x:Bind ViewModel.PingHost, Mode=TwoWay}"
                             PlaceholderText="e.g. 1.1.1.1" />
                    <TextBlock Text="Host pinged to measure latency and jitter. Default 1.1.1.1 (Cloudflare)."
                               Style="{StaticResource HelpTextStyle}" />
                </StackPanel>
            </Expander>

            <!-- Affinity Masks -->
            <Expander Header="CPU Affinity Masks" IsExpanded="True"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8" Padding="0,8,0,0">
                    <TextBlock Style="{StaticResource HelpTextStyle}">
                        Hex bitmasks. Each bit = one logical processor.
                        Default for an 8c/16t single-CCD CPU: Game 0x3FFF (cores 0-6),
                        Media (FF/VLC) 0x4000, Background 0x8000 (both halves of core 7).
                    </TextBlock>
                    <TextBox Header="Game affinity mask (hex)" Text="{x:Bind ViewModel.GameAffinityHex, Mode=TwoWay}" />
                    <TextBox Header="Firefox+VLC affinity mask (hex)" Text="{x:Bind ViewModel.FirefoxAffinityHex, Mode=TwoWay}" />
                    <TextBox Header="Background affinity mask (hex)" Text="{x:Bind ViewModel.BgAffinityHex, Mode=TwoWay}" />
                </StackPanel>
            </Expander>

            <!-- Per-Game Profiles -->
            <Expander Header="Per-Game Profiles" IsExpanded="False"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8" Padding="0,8,0,0">
                    <TextBlock Style="{StaticResource HelpTextStyle}">
                        Override CPU affinity and priority for specific games by process name.
                        A game with no profile uses the game affinity mask above at High priority.
                        Leave the affinity blank to keep the default mask but change only priority.
                    </TextBlock>
                    <ListView ItemsSource="{x:Bind ViewModel.GameProfiles}" SelectionMode="None"
                              MaxHeight="200">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:GameProfile">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Summary}" VerticalAlignment="Center"
                                               FontFamily="Consolas" FontSize="11" />
                                    <Button Grid.Column="1" Content="&#xE74D;"
                                            FontFamily="Segoe Fluent Icons" FontSize="12"
                                            Click="RemoveProfile_Click" Tag="{x:Bind}"
                                            Style="{StaticResource DateTimePickerFlyoutButtonStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox PlaceholderText="process name (no .exe)"
                                 Text="{x:Bind ViewModel.NewProfileName, Mode=TwoWay}" />
                        <TextBox Grid.Column="1" Width="110" PlaceholderText="affinity hex"
                                 Text="{x:Bind ViewModel.NewProfileAffinityHex, Mode=TwoWay}" />
                        <ComboBox Grid.Column="2" Width="130"
                                  ItemsSource="{x:Bind ViewModel.PriorityOptions}"
                                  SelectedItem="{x:Bind ViewModel.NewProfilePriority, Mode=TwoWay}" />
                        <Button Grid.Column="3" Content="Add"
                                Command="{x:Bind ViewModel.AddProfileCommand}" />
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- Alert Thresholds -->
            <Expander Header="Alert Thresholds" IsExpanded="False"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8" Padding="0,8,0,0">
                    <NumberBox Header="GPU temperature alert (°C)" Value="{x:Bind ViewModel.AlertGpuTempC, Mode=TwoWay}"
                               Minimum="50" Maximum="110" SpinButtonPlacementMode="Inline" />
                    <NumberBox Header="VRAM usage alert (%)" Value="{x:Bind ViewModel.AlertVramPct, Mode=TwoWay}"
                               Minimum="50" Maximum="100" SpinButtonPlacementMode="Inline" />
                    <NumberBox Header="GPU util sustained alert (%)" Value="{x:Bind ViewModel.AlertGpuUtilPct, Mode=TwoWay}"
                               Minimum="50" Maximum="100" SpinButtonPlacementMode="Inline" />
                    <NumberBox Header="Game CPU zone alert (%)" Value="{x:Bind ViewModel.AlertCpuZonePct, Mode=TwoWay}"
                               Minimum="50" Maximum="100" SpinButtonPlacementMode="Inline" />
                    <NumberBox Header="Sustained ticks (x3s) before alert fires" Value="{x:Bind ViewModel.AlertSustainedTicks, Mode=TwoWay}"
                               Minimum="1" Maximum="20" SpinButtonPlacementMode="Inline" />
                </StackPanel>
            </Expander>

            <!-- Game Paths -->
            <Expander Header="Game Library Paths" IsExpanded="False"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8" Padding="0,8,0,0">
                    <TextBlock Style="{StaticResource HelpTextStyle}">
                        Processes whose executable is inside one of these paths are treated as games
                        and receive High priority + game affinity.
                    </TextBlock>
                    <ListView ItemsSource="{x:Bind ViewModel.GamePaths}" SelectionMode="None"
                              MaxHeight="200">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind}" VerticalAlignment="Center"
                                               FontFamily="Consolas" FontSize="11" />
                                    <Button Grid.Column="1" Content="&#xE74D;"
                                            FontFamily="Segoe Fluent Icons" FontSize="12"
                                            Click="RemoveGamePath_Click" Tag="{x:Bind}"
                                            Style="{StaticResource DateTimePickerFlyoutButtonStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox PlaceholderText="C:\Games\..." Text="{x:Bind ViewModel.NewGamePath, Mode=TwoWay}" />
                        <Button Grid.Column="1" Content="Add" Command="{x:Bind ViewModel.AddGamePathCommand}" />
                        <Button Grid.Column="2" Content="Detect Libraries"
                                Command="{x:Bind ViewModel.DetectGamePathsCommand}"
                                ToolTipService.ToolTip="Scan Steam, Epic, GOG, Ubisoft, and EA installs for game libraries" />
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- Extra Throttled Procs -->
            <Expander Header="Extra Background Processes to Throttle" IsExpanded="False"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8" Padding="0,8,0,0">
                    <TextBlock Style="{StaticResource HelpTextStyle}">
                        Additional process names (no .exe) to pin to the Background zone
                        and set to Idle priority when gaming.
                    </TextBlock>
                    <ListView ItemsSource="{x:Bind ViewModel.ExtraThrottledProcs}" SelectionMode="None"
                              MaxHeight="120">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind}" VerticalAlignment="Center" FontFamily="Consolas" FontSize="12" />
                                    <Button Grid.Column="1" Content="&#xE74D;"
                                            FontFamily="Segoe Fluent Icons" FontSize="12"
                                            Click="RemoveThrottledProc_Click" Tag="{x:Bind}"
                                            Style="{StaticResource DateTimePickerFlyoutButtonStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox PlaceholderText="processname (no .exe)" Text="{x:Bind ViewModel.NewThrottledProc, Mode=TwoWay}" />
                        <Button Grid.Column="1" Content="Add" Command="{x:Bind ViewModel.AddThrottledProcCommand}" />
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- Pause Apps During Gameplay -->
            <Expander Header="Pause Apps During Gameplay" IsExpanded="False"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="8" Padding="0,8,0,0">
                    <TextBlock Style="{StaticResource HelpTextStyle}">
                        These apps are fully suspended (frozen) while a game is running and
                        resumed when it closes - cloud-sync clients like OneDrive are the main
                        cause of mid-game disk stutter. Uncheck an entry to keep it in the list
                        without suspending it. Requires CPU pinning to be on.
                    </TextBlock>
                    <ListView ItemsSource="{x:Bind ViewModel.SuspendApps}" SelectionMode="None"
                              MaxHeight="160">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="services:SuspendApp">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Content="{x:Bind ProcessName}"
                                              IsChecked="{x:Bind Enabled, Mode=TwoWay}"
                                              FontFamily="Consolas" FontSize="12" />
                                    <Button Grid.Column="1" Content="&#xE74D;"
                                            FontFamily="Segoe Fluent Icons" FontSize="12"
                                            Click="RemoveSuspendApp_Click" Tag="{x:Bind}"
                                            Style="{StaticResource DateTimePickerFlyoutButtonStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox PlaceholderText="process name (no .exe)"
                                 Text="{x:Bind ViewModel.NewSuspendApp, Mode=TwoWay}" />
                        <Button Grid.Column="1" Content="Add"
                                Command="{x:Bind ViewModel.AddSuspendAppCommand}" />
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- Save / Back buttons -->
            <Border Height="1" Background="{StaticResource HairlineBrush}" Margin="0,2,0,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Save Settings" Command="{x:Bind ViewModel.SaveCommand}"
                        Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="SaveBackBtn" Content="Save and Back" Click="SaveBackBtn_Click" />
                <Button x:Name="CancelBtn" Content="Cancel" Click="BackBtn_Click" />
                <TextBlock Text="{x:Bind ViewModel.SaveStatus, Mode=OneWay}"
                           VerticalAlignment="Center" FontSize="12" Foreground="#50C864" />
            </StackPanel>
            <TextBlock Text="Settings apply immediately, except service stops and start-minimized (next optimizer start)."
                       Style="{StaticResource HelpTextStyle}" Opacity="0.5" />

            <!-- Danger zone -->
            <Border CornerRadius="8" Padding="14,10" BorderThickness="1"
                    BorderBrush="#44FF4444">
                <Border.Background>
                    <SolidColorBrush Color="#220A0A" />
                </Border.Background>
                <StackPanel Spacing="6">
                    <TextBlock Text="DANGER ZONE" Style="{StaticResource SectionHeaderStyle}"
                               Foreground="#FF6666" Opacity="0.85" />
                    <TextBlock Style="{StaticResource HelpTextStyle}" Opacity="0.7">
                        Immediately restores all process affinities and priorities to Windows defaults,
                        re-enables SysMain, and clears all pinning state. Use if the app has left
                        processes in a bad state.
                    </TextBlock>
                    <Button x:Name="ResetAllBtn" Click="ResetAllBtn_Click" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE777;" FontSize="14" Foreground="#FF6666" />
                            <TextBlock Text="Reset All Process State" FontSize="12"
                                       Foreground="#FF6666" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
